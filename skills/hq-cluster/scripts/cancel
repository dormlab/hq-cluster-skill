#!/usr/bin/env bash
# cancel -- cancel a job by id, or all jobs matching a name.
#
# Usage:
#   cancel <id>
#   cancel --name <prefix>
set -euo pipefail

if [[ "${1:-}" == "--name" ]]; then
  PAT="${2:-}"
  [[ -z "$PAT" ]] && { echo "usage: cancel --name <prefix>" >&2; exit 64; }
  IDS=$(hq jobs --output-mode=json 2>/dev/null \
        | jq -r --arg p "$PAT" '.[] | select(.name | startswith($p)) | select(.info.state == "WAITING" or .info.state == "RUNNING") | .id')
  if [[ -z "$IDS" ]]; then
    echo "no jobs matching prefix '$PAT'"
    exit 0
  fi
  echo "canceling: $IDS"
  for J in $IDS; do hq job cancel "$J" >/dev/null; done
  exit 0
fi

JID="${1:-}"
[[ -z "$JID" ]] && { echo "usage: cancel <id> | --name <prefix>" >&2; exit 64; }
hq job cancel "$JID"
